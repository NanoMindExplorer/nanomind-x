+// Local patch 2026-11-05 (hero): read the CLI session file (Cookie-Editor
+// JSON) and set its cookies on the page. No credentials are logged or stored
+// anywhere new; the file is only read.
+async function loadSessionCookiesIntoPage(pg) {
+  try {
+    const cookiePath = path.join(os.homedir(), '.nanomind-x', 'cookies.json');
+    const cookies = JSON.parse(await fs.readFile(cookiePath, 'utf8'));
+    const sameSiteMap = { no_restriction: 'None', lax: 'Lax', strict: 'Strict' };
+    const mapped = cookies
+      .filter((c) => c.name && typeof c.value === 'string')
+      .map((c) => ({
+        name: c.name,
+        value: c.value,
+        domain: c.domain || '.x.com',
+        path: c.path || '/',
+        expires: c.expirationDate || undefined,
+        httpOnly: !!c.httpOnly,
+        secure: !!c.secure,
+        sameSite: sameSiteMap[c.sameSite] || undefined,
+      }));
+    // A page can only receive cookies for a domain it has visited.
+    await pg.goto('https://x.com/', { waitUntil: 'domcontentloaded' });
+    await pg.setCookie(...mapped);
+  } catch {
+    // No saved session — browser actions will run logged out and fail cleanly.
+  }
+}
